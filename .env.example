# DhanHQ Credentials (REQUIRED)
# Get from https://dhan.co → Settings → API
DHAN_CLIENT_ID=your_10_digit_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# PIN + TOTP Secret for automatic token generation (OPTIONAL but recommended)
# DHAN_PIN: 6-digit PIN from Dhan login
# DHAN_TOTP_SECRET: base32 secret from Dhan 2FA setup (e.g., "JBSWY3DPEHPK3PXP")
# With these set, `python auth_pin_totp.py` will auto-generate TOTP and fetch token
DHAN_PIN=123456
DHAN_TOTP_SECRET=your_base32_totp_secret_here

# Ollama Configuration (OPTIONAL - defaults shown)
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/generate

# Risk Parameters (OPTIONAL - defaults shown)
# MAX_CAPITAL_PER_TRADE_PCT=0.02
# STOP_LOSS_PCT=0.50
# TARGET_PCT=0.90
# MAX_OPEN_LEGS=3
# MIN_OI=500000
# MIN_DELTA=0.25
# MAX_DELTA=0.45
# MIN_IVR=40
# MAX_BID_ASK_SPREAD_PCT=0.005

# Instrument Settings (OPTIONAL - verify from Dhan instrument master CSV)
# NIFTY_LOT_SIZE=25
# BANKNIFTY_LOT_SIZE=15